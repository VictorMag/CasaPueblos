# ─── Build output ────────────────────────────────────────────────────────
dist/
.output/

# ─── Generated types (Astro) ─────────────────────────────────────────────
.astro/

# ─── Dependencies ────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ─── Environment variables ───────────────────────────────────────────────
# IMPORTANTE: nunca commitear secretos. Si surge un .env en el futuro,
# commiteamos un .env.example sin valores reales.
.env
.env.local
.env.*.local
.env.production
.env.development

# ─── TypeScript build info ───────────────────────────────────────────────
*.tsbuildinfo

# ─── Coverage / tests ────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Editores: user-specific ─────────────────────────────────────────────
# JetBrains (WebStorm, IntelliJ)
.idea/

# VSCode — se mantienen extensions.json y launch.json compartidos,
# pero ignoramos configuración personal del usuario.
.vscode/settings.json
.vscode/*.local.json

# Vim / Emacs
*.swp
*.swo
*~

# Sublime
*.sublime-project
*.sublime-workspace

# ─── Claude Code: configuración local del usuario ────────────────────────
.claude/settings.local.json
.claude/local/

# ─── OS: macOS ───────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# ─── OS: Windows ─────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── OS: Linux ───────────────────────────────────────────────────────────
.directory
.Trash-*

# ─── Privacidad del proyecto (Casa de los Pueblos del Sur) ───────────────
# Por la naturaleza del proyecto (mujeres en riesgo, datos de migrantes),
# cualquier documento del cliente con información personal NUNCA debe entrar
# al repo. Carpetas de borrador para uso local:
notas/
notas-cliente/
private/
documentos-cliente/
*.private.md
*.private.txt
*-confidencial.*

# ─── Deploy artifacts ────────────────────────────────────────────────────
# Por si se generan paquetes ZIP para subir a Hostinger manualmente
*.zip
*.tar.gz
deploy/

# ─── Auditorías / reportes ──────────────────────────────────────────────
lighthouse-report.*
*.report.json
*.report.html

# ─── Backups de assets antes de optimizar ───────────────────────────────
*.bak
*.original.*
