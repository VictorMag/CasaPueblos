# ─── Seguridad HTTP — Casa de los Pueblos del Sur ────────────────────────────
# Servidor: Apache (Hostinger). Copia este archivo a public_html/.htaccess

# HTTPS forzado (activa HSTS solo después de confirmar que HTTPS funciona en Hostinger)
# Para activar HSTS: descomenta las siguientes líneas y ponlas al inicio:
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Headers de seguridad
<IfModule mod_headers.c>
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  # no-referrer coincide con el <meta name="referrer"> del BaseLayout; coherente con
  # la política de privacidad del proyecto (no filtrar destinos a sitios externos).
  Header set Referrer-Policy "no-referrer"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  # CSP — permite Google Fonts (fonts.googleapis.com para CSS, fonts.gstatic.com para
  # los archivos .woff2). 'unsafe-inline' en script-src se necesita para el JSON-LD
  # inline; en style-src para los estilos `style="..."` de los componentes Astro.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# Compresión gzip para mejor rendimiento
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 day"
</IfModule>

# Evita listar directorios
Options -Indexes

# Manejo de errores
ErrorDocument 404 /404.html
