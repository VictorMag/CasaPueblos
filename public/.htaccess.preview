# ─── Preview / Staging — Casa de los Pueblos del Sur ─────────────────────────
# Este archivo se usa SOLO en public_html/preview/ (rama preview).
# Deshabilita el caché de LiteSpeed y del browser para que los cambios
# sean visibles de inmediato al actualizar la página.

# Deshabilitar LiteSpeed Page Cache (LSCache)
<IfModule LiteSpeed>
    CacheLookup off
</IfModule>

# Sin caché en HTML — el browser siempre pide la versión más reciente
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>

# Assets con hash de Astro (_astro/) — pueden cachear porque el nombre cambia
# con cada build. El resto sin caché para evitar inconsistencias en staging.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 0 seconds"
    ExpiresByType application/javascript   "access plus 0 seconds"
    ExpiresByType image/avif               "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType application/json        "access plus 0 seconds"
</IfModule>

# Headers de seguridad (igual que producción)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "no-referrer"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# Compresión gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Sin listado de directorios
Options -Indexes

# Manejo de errores — apunta al 404 del subdirectorio preview
ErrorDocument 404 /preview/404.html
