---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import Header from '../components/Header';
import ExitButton from '../components/ExitButton';
import Footer from '../components/Footer.astro';

const title       = "Quiénes somos — Casa de los Pueblos del Sur";
const description = "Conoce a los socios fundadores, la misión y la visión de Casa de los Pueblos del Sur, organización de apoyo comunitario en el sur de la Ciudad de México.";

const membersJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": site.nombre,
  "url": site.url,
  "member": site.sociosFundadores.map(s => ({
    "@type": "Person",
    "name": s.nombre,
    "jobTitle": s.titulo,
  })),
};
---

<BaseLayout title={title} description={description}>
  <Header client:load telefonoEmergencia={site.casaMorada.telefonoFijo} />

  <main id="main-content">

    <!-- ── Hero corto ─────────────────────────────────────────────────────── -->
    <section
      aria-labelledby="qs-heading"
      style="
        background-color: var(--color-surface-alt);
        padding-block: clamp(4rem, 10vw, 7rem);
        min-height: 45vh;
        display: flex;
        align-items: center;
      "
    >
      <div class="container">
        <div style="display: flex; flex-direction: column; gap: 1.25rem; max-width: 640px;">
          <h1 id="qs-heading" data-reveal data-reveal-delay="0">Quiénes somos</h1>
          <p
            data-reveal
            data-reveal-delay="160"
            style="
              font-family: 'Playfair Display', Georgia, serif;
              font-size: var(--fs-h3);
              font-weight: 400;
              color: var(--color-text-muted);
              font-style: italic;
              max-width: none;
              line-height: 1.5;
            "
          >
            Una red de profesionales y voluntarios que acompaña al sur de la Ciudad de México.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Misión y Visión ────────────────────────────────────────────────── -->
    <section
      aria-label="Misión y visión de la organización"
      style="
        background-color: var(--color-bg);
        padding-block: clamp(4rem, 8vw, 6rem);
      "
    >
      <div class="container">
        <div class="mv-grid">

          <div data-reveal>
            <h2 style="margin-bottom: 1.25rem;">Misión</h2>
            <p style="color: var(--color-text-muted); line-height: 1.8; max-width: 55ch;">
              {site.mision}
            </p>
          </div>

          <div data-reveal data-reveal-delay="120" class="mv-vision">
            <h2 style="margin-bottom: 1.25rem;">Visión</h2>
            <p style="color: var(--color-text-muted); line-height: 1.8; max-width: 55ch;">
              {site.vision}
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── Socios fundadores ──────────────────────────────────────────────── -->
    <section
      aria-labelledby="socios-heading"
      style="
        background-color: var(--color-surface-alt);
        padding-block: clamp(4rem, 8vw, 6rem);
      "
    >
      <div class="container">

        <div data-reveal style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: clamp(2rem, 4vw, 3rem);">
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <span
              style="
                font-size: var(--fs-small);
                font-weight: 600;
                color: var(--color-primary);
                text-transform: uppercase;
                letter-spacing: 0.14em;
              "
            >
              {site.sociosFundadores.length} profesionales
            </span>
            <span
              aria-hidden="true"
              style="width: 2.5rem; height: 2px; background-color: var(--color-primary);"
            ></span>
          </div>
          <h2 id="socios-heading">Socios fundadores</h2>
          <p style="color: var(--color-text-muted); line-height: 1.7; max-width: 55ch;">
            Profesionales y profesionistas que sostienen la organización desde su origen.
          </p>
        </div>

        <div class="socios-grid">
          {site.sociosFundadores.map(socio => (
            <article class="socio-card">
              <p class="socio-nombre">{socio.nombre}</p>
              {socio.titulo && <p class="socio-titulo">{socio.titulo}</p>}
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- ── CTA ────────────────────────────────────────────────────────────── -->
    <section
      aria-label="Llamada a la acción para voluntarios y aliados"
      style="
        background-color: var(--color-primary-soft);
        padding-block: clamp(3rem, 6vw, 5rem);
      "
    >
      <div
        class="container"
        style="display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem;"
      >
        <p
          style="
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--fs-h3);
            font-weight: 500;
            color: var(--color-primary-deep);
            max-width: 42ch;
            line-height: 1.4;
          "
        >
          ¿Quieres sumarte como voluntario o aliado?
        </p>
        <a
          href={`mailto:${site.contactoGeneral.email}`}
          class="btn btn-primary"
          aria-label="Escribir un correo para sumarse como voluntario o aliado"
        >
          Escríbenos
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </div>
    </section>

  </main>

  <!-- JSON-LD: miembros de la organización. Sin teléfonos — solo nombre y cargo. -->
  <script type="application/ld+json" set:html={JSON.stringify(membersJsonLd)} />

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(el => {
        const delay = parseInt(el.dataset.revealDelay ?? '0', 10);
        el.style.animationDelay = delay + 'ms';
        el.classList.add('is-visible');
      });
    });
  </script>

  <Footer />
  <ExitButton client:load />
</BaseLayout>

<style>
  /* ── Misión / Visión ── */
  .mv-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 768px) {
    .mv-grid {
      grid-template-columns: 1fr 1fr;
    }
    .mv-vision {
      border-left: 1px solid var(--color-border);
      padding-left: clamp(2rem, 4vw, 3rem);
    }
  }

  /* ── Grid de socios ── */
  .socios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  /* ── Tarjeta de socio ── */
  .socio-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .socio-nombre {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.3;
    max-width: none;
  }

  .socio-titulo {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.4;
    max-width: none;
  }

  /* ── Cascading fade-in ── */
  @keyframes qs-reveal {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
  }

  [data-reveal].is-visible {
    animation: qs-reveal 0.72s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; animation: none !important; }
  }

</style>
