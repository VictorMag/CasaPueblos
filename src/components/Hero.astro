---
// Hero — fondo: mural comunitario + overlays morados para legibilidad del texto
import { url } from '../utils/url';
---

<section
  id="inicio"
  aria-labelledby="hero-heading"
  class="hero"
>
  <!--
    Imagen de portada: hero-mural en AVIF/WebP/PNG (cascada por compatibilidad).
    AVIF ~276KB, WebP ~293KB, PNG fallback ~660KB. Original era 2.6MB.
    Dimensiones: 1672×941 (suficiente para hero de pantalla completa hasta ~1920px).
  -->
  <picture class="hero-bg-picture">
    <source srcset={url('/images/hero-mural.avif')} type="image/avif" />
    <source srcset={url('/images/hero-mural.webp')} type="image/webp" />
    <img
      class="hero-bg-img"
      src={url('/images/hero-mural.png')}
      alt=""
      width="1672"
      height="941"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      aria-hidden="true"
    />
  </picture>

  <!-- Capas de oscurecimiento sobre la imagen -->
  <div class="hero-gradient" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="hero-eyebrow" data-reveal data-reveal-delay="0">
      <span>Sur de México</span>
      <span class="dot" aria-hidden="true">·</span>
      <span>Comunidad</span>
      <span class="dot" aria-hidden="true">·</span>
      <span>Dignidad</span>
    </p>

    <h1 id="hero-heading" class="hero-headline">
      <span class="line" data-line>Juntos</span>
      <span class="line line-italic" data-line><em>construimos</em></span>
      <span class="line" data-line>comunidad</span>
    </h1>

    <p class="hero-description" data-reveal data-reveal-delay="520">
      Apoyo integral a mujeres, migrantes y familias del sur de la Ciudad de México
    </p>

    <div class="hero-ctas" data-reveal data-reveal-delay="660">
      <a href="#migrantes" class="btn hero-cta-primary" aria-label="Conoce nuestros servicios">
        Conoce nuestros servicios
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
      <a href="#la-casa-morada" class="btn hero-cta-secondary" aria-label="Contáctanos">
        Contáctanos
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    background-color: var(--color-primary-deep);
    overflow: hidden;
  }

  /* Imagen de fondo (mural) — 140% de alto para que el parallax tenga margen */
  .hero-bg-picture {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: block;
  }
  .hero-bg-img {
    position: absolute;
    top: -20%;
    left: 0;
    right: 0;
    width: 100%;
    height: 140%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    will-change: transform;
  }

  /* Overlay morado semitransparente sobre la imagen — el mural es muy colorido,
     necesita un velo fuerte para que el texto blanco mantenga contraste. */
  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      oklch(20% 0.10 305 / 0.30) 0%,
      oklch(25% 0.13 305 / 0.70) 55%,
      oklch(18% 0.09 305 / 0.20) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Viñeta para profundidad — refuerza los bordes oscuros */
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 90% 80% at 50% 50%,
      transparent 0%,
      oklch(12% 0.07 305 / 0.20) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.8vw, 1.25rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    max-width: 900px;
  }

  /* ── Animación ──────────────────────────────────────── */
  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-reveal],
  .hero-headline .line {
    opacity: 0;
    transform: translateY(24px);
  }

  [data-reveal].is-visible,
  .hero-headline .line.is-visible {
    animation: hero-reveal 0.72s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    .hero-headline .line {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }

  /* ── Eyebrow ────────────────────────────────────────── */
  .hero-eyebrow {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: var(--fs-small);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: oklch(78% 0.06 305);
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero-eyebrow .dot {
    opacity: 0.55;
  }

  /* ── Headline tipográfico ───────────────────────────── */
  .hero-headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 700;
    line-height: 0.98;
    color: var(--color-surface);
    margin: 0;
    display: flex;
    flex-direction: column;
    letter-spacing: -0.015em;
  }

  .hero-headline .line {
    display: block;
  }

  .hero-headline .line-italic em {
    font-style: italic;
    font-weight: 400;
    color: oklch(78% 0.10 305);
    display: inline-block;
  }

  /* ── Descripción ────────────────────────────────────── */
  .hero-description {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: oklch(85% 0.04 305);
    max-width: 38ch;
    line-height: 1.5;
  }

  /* ── CTAs ───────────────────────────────────────────── */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-cta-primary,
  .hero-cta-secondary {
    padding: 1rem 1.75rem;
    font-size: var(--fs-body);
    font-weight: 500;
    border-radius: 0.25rem;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .hero-cta-primary {
    background-color: oklch(40% 0.16 305);
    color: var(--color-surface);
    border: 2px solid oklch(40% 0.16 305);
  }
  .hero-cta-primary:hover {
    background-color: oklch(48% 0.17 305);
    border-color: oklch(48% 0.17 305);
  }

  .hero-cta-secondary {
    background-color: oklch(28% 0.11 305);
    color: var(--color-surface);
    border: 2px solid oklch(28% 0.11 305);
  }
  .hero-cta-secondary:hover {
    background-color: oklch(34% 0.13 305);
    border-color: oklch(34% 0.13 305);
  }

  /* ── Mobile ─────────────────────────────────────────── */
  @media (max-width: 767px) {
    .hero {
      min-height: 75vh;
    }
    .hero-headline {
      letter-spacing: -0.01em;
    }
  }
</style>

<script>
  // Cascading fade-in al cargar
  // Orden: eyebrow → línea 1 → línea 2 → línea 3 → descripción → botones
  const LINE_BASE = 120;
  const LINE_STAGGER = 130;

  window.addEventListener('DOMContentLoaded', () => {
    // Elementos con data-reveal (eyebrow, descripción, CTAs)
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(el => {
      const delay = parseInt(el.dataset.revealDelay ?? '0', 10);
      el.style.animationDelay = delay + 'ms';
      el.classList.add('is-visible');
    });

    // Líneas del titular en cascada
    document.querySelectorAll<HTMLElement>('.hero-headline [data-line]').forEach((line, i) => {
      line.style.animationDelay = (LINE_BASE + i * LINE_STAGGER) + 'ms';
      line.classList.add('is-visible');
    });
  });

  // Parallax — se desactiva si el usuario prefiere movimiento reducido
  const heroBg = document.querySelector<HTMLElement>('.hero-bg-img');
  if (heroBg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const FACTOR = 0.15;
    let rafId = 0;

    window.addEventListener('scroll', () => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        heroBg.style.transform = `translateY(${window.scrollY * FACTOR}px)`;
      });
    }, { passive: true });
  }
</script>
