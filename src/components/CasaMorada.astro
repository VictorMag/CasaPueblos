---
import { site } from '../config/site';
---

<section
  id="la-casa-morada"
  aria-labelledby="casa-morada-heading"
  style="
    background-color: var(--color-primary-deep);
    color: var(--color-surface);
    padding-block: var(--section-pad-y);
  "
>
  <div class="container">
    <div
      style="
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(2.5rem, 6vw, 4rem);
        align-items: start;
      "
      class="casa-morada-grid"
    >
      <!-- Columna izquierda: texto -->
      <div data-reveal style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <span
            style="
              font-size: var(--fs-small);
              font-weight: 600;
              color: var(--color-primary-soft);
              text-transform: uppercase;
              letter-spacing: 0.14em;
            "
          >
            Refugio y protección
          </span>
          <span
            aria-hidden="true"
            style="
              width: 2.5rem;
              height: 2px;
              background-color: var(--color-primary-soft);
            "
          ></span>
        </div>

        <h2
          id="casa-morada-heading"
          style="color: var(--color-surface);"
        >
          La Casa Morada
        </h2>

        <p
          style="
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--fs-h3);
            font-weight: 400;
            color: oklch(88% 0.04 305);
            max-width: none;
            font-style: italic;
          "
        >
          Un espacio seguro para mujeres en situación de riesgo
        </p>

        <p style="color: oklch(85% 0.03 305); line-height: 1.75; font-size: var(--fs-body);">
          En Casa de los Pueblos del Sur entendemos que pedir ayuda requiere valor. Nuestro equipo
          está disponible las 24 horas del día, los 7 días de la semana, para escucharte sin juzgarte.
        </p>

        <p style="color: oklch(85% 0.03 305); line-height: 1.75; font-size: var(--fs-body);">
          Ofrecemos acompañamiento psicológico, asesoría legal y, cuando es necesario,
          reubicación en una casa segura con la identidad y la ubicación completamente protegidas.
        </p>

        <p
          style="
            font-size: var(--fs-small);
            color: oklch(70% 0.05 305);
            margin-top: 0.5rem;
            max-width: none;
            line-height: 1.6;
          "
        >
          Las direcciones de nuestras casas seguras son confidenciales por la protección
          de quienes las habitan. Nunca compartimos esta información por ningún medio.
        </p>
      </div>

      <!-- Columna derecha: tarjeta de emergencia -->
      <div data-reveal data-reveal-delay="150">
        <div
          style="
            background-color: var(--color-surface);
            border: 2px solid var(--color-emergency);
            border-radius: 0.5rem;
            padding: clamp(1.25rem, 4vw, 2.5rem);
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            width: 100%;
            overflow: hidden;
          "
        >
          <!-- Ícono de teléfono -->
          <div
            style="
              display: flex;
              align-items: center;
              gap: 0.75rem;
              color: var(--color-emergency);
            "
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.24h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span
              style="
                font-size: var(--fs-small);
                font-weight: 600;
                color: var(--color-text);
                text-transform: uppercase;
                letter-spacing: 0.08em;
              "
            >
              Línea de emergencia 24/7
            </span>
          </div>

          <!-- Número de teléfono — elemento más prominente del sitio -->
          <a
            href={`tel:${site.casaMorada.telefonoFijo}`}
            style="
              font-family: 'Playfair Display', Georgia, serif;
              font-size: clamp(1.75rem, 7vw, 3.5rem);
              font-weight: 600;
              color: var(--color-emergency);
              text-decoration: none;
              line-height: 1.1;
              display: block;
              word-break: break-all;
            "
            aria-label={`Llamar a la línea de emergencia: ${site.casaMorada.telefonoFijo}`}
          >
            {site.casaMorada.telefonoFijo}
          </a>

          <!-- Botón WhatsApp -->
          {site.casaMorada.whatsapp && !site.casaMorada.whatsapp.startsWith('[') && (
            <a
              href={`https://wa.me/${site.casaMorada.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
              style="justify-content: center; font-size: var(--fs-body);"
              aria-label="Escribir por WhatsApp a la línea de emergencia 24/7"
            >
              <!-- Ícono WhatsApp SVG inline -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
              WhatsApp 24/7
            </a>
          )}

          <p
            style="
              font-size: var(--fs-small);
              color: var(--color-text-muted);
              line-height: 1.5;
              max-width: none;
              border-top: 1px solid var(--color-border);
              padding-top: 1rem;
            "
          >
            Las direcciones de nuestras casas seguras son confidenciales por la
            protección de quienes las habitan.
          </p>
        </div>
      </div>
    </div>

    <!-- CTA principal — ancho completo -->
    <div style="margin-top: clamp(2.5rem, 5vw, 3.5rem); text-align: center;">
      <a
        href={`tel:${site.casaMorada.telefonoFijo}`}
        class="btn btn-emergency casa-morada-cta"
        style="
          padding: 1rem 2rem;
          font-size: clamp(1rem, 2.5vw, var(--fs-h3));
          display: inline-flex;
          align-items: center;
          gap: 0.75rem;
          max-width: 100%;
        "
        aria-label="Pedir ayuda ahora llamando a la línea de emergencia"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.24h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Pedir ayuda ahora
      </a>
    </div>
  </div>
</section>

<style>
  .casa-morada-grid {
    grid-template-columns: 1fr;
  }

  /* Ambas columnas deben poder comprimir su contenido */
  .casa-morada-grid > * {
    min-width: 0;
    width: 100%;
  }

  @media (min-width: 768px) {
    .casa-morada-grid {
      grid-template-columns: 3fr 2fr;
    }
  }
</style>
