---
import { site } from '../config/site';
---

<section
  id="salud"
  aria-labelledby="salud-heading"
  style="
    background-color: var(--color-bg);
    padding-block: var(--section-pad-y);
    content-visibility: auto;
    contain-intrinsic-size: 0 700px;
  "
>
  <div class="container">
    <div style="display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 3.5rem);">

      <!-- Encabezado -->
      <div data-reveal style="display: flex; flex-direction: column; gap: 0.875rem; max-width: var(--prose-width);">
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <span
            style="
              font-size: var(--fs-small);
              font-weight: 600;
              color: var(--color-primary);
              text-transform: uppercase;
              letter-spacing: 0.14em;
            "
          >
            Salud comunitaria
          </span>
          <span
            aria-hidden="true"
            style="
              width: 2.5rem;
              height: 2px;
              background-color: var(--color-primary);
            "
          ></span>
        </div>

        <h2 id="salud-heading">Clínica Comunitaria</h2>
        <p style="font-style: italic; font-family: 'Playfair Display', Georgia, serif; font-size: var(--fs-h3); font-weight: 400; color: var(--color-text-muted); max-width: none;">
          Consultas médicas gratuitas para tu familia
        </p>
      </div>

      <!-- Tres tarjetas de especialidad -->
      <div
        style="
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
          gap: 1.5rem;
        "
      >

        <!-- Pediatría -->
        <article
          class="card"
          data-reveal
          data-reveal-delay="0"
          style="display: flex; flex-direction: column; gap: 1rem;"
          aria-label="Especialidad de pediatría"
        >
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div
              style="
                width: 48px;
                height: 48px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: var(--color-primary-soft);
                border-radius: 0.5rem;
              "
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12h.01"/>
                <path d="M15 12h.01"/>
                <path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/>
                <path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"/>
              </svg>
            </div>
            <h3>Pediatría</h3>
          </div>
          <dl style="display: flex; flex-direction: column; gap: 0.5rem; font-size: var(--fs-small); flex: 1;">
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Médico</dt>
              <dd style="color: var(--color-text); margin: 0.125rem 0 0;">{site.salud.pediatria.doctor}</dd>
            </div>
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Horario</dt>
              <dd style="color: var(--color-text); margin: 0.125rem 0 0;">{site.salud.pediatria.horario}</dd>
            </div>
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Citas</dt>
              <dd style="margin: 0.125rem 0 0;">
                <a
                  href={`tel:${site.salud.pediatria.telefono}`}
                  style="color: var(--color-primary); font-weight: 500; text-decoration: none;"
                  aria-label={`Llamar para cita de pediatría: ${site.salud.pediatria.telefono}`}
                >
                  {site.salud.pediatria.telefono}
                </a>
              </dd>
            </div>
          </dl>
        </article>

        <!-- Neurología -->
        <article
          class="card"
          data-reveal
          data-reveal-delay="120"
          style="display: flex; flex-direction: column; gap: 1rem;"
          aria-label="Especialidad de neurología"
        >
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div
              style="
                width: 48px;
                height: 48px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: var(--color-primary-soft);
                border-radius: 0.5rem;
              "
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/>
                <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/>
                <path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/>
                <path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/>
                <path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/>
                <path d="M3.477 10.896a4 4 0 0 1 .585-.396"/>
                <path d="M19.938 10.5a4 4 0 0 1 .585.396"/>
                <path d="M6 18a4 4 0 0 1-1.967-.516"/>
                <path d="M19.967 17.484A4 4 0 0 1 18 18"/>
              </svg>
            </div>
            <h3>Neurología</h3>
          </div>
          <dl style="display: flex; flex-direction: column; gap: 0.5rem; font-size: var(--fs-small); flex: 1;">
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Médico</dt>
              <dd style="color: var(--color-text); margin: 0.125rem 0 0;">{site.salud.neurologia.doctor}</dd>
            </div>
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Horario</dt>
              <dd style="color: var(--color-text); margin: 0.125rem 0 0;">{site.salud.neurologia.horario}</dd>
            </div>
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Citas</dt>
              <dd style="margin: 0.125rem 0 0;">
                <a
                  href={`tel:${site.salud.neurologia.telefono}`}
                  style="color: var(--color-primary); font-weight: 500; text-decoration: none;"
                  aria-label={`Llamar para cita de neurología: ${site.salud.neurologia.telefono}`}
                >
                  {site.salud.neurologia.telefono}
                </a>
              </dd>
            </div>
          </dl>
        </article>

        <!-- Prevención del Alzheimer -->
        <article
          class="card"
          data-reveal
          data-reveal-delay="240"
          style="display: flex; flex-direction: column; gap: 1rem;"
          aria-label="Especialidad de prevención del Alzheimer"
        >
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div
              style="
                width: 48px;
                height: 48px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: var(--color-primary-soft);
                border-radius: 0.5rem;
              "
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                <path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>
              </svg>
            </div>
            <h3>Prevención del Alzheimer</h3>
          </div>
          <dl style="display: flex; flex-direction: column; gap: 0.5rem; font-size: var(--fs-small); flex: 1;">
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Médico</dt>
              <dd style="color: var(--color-text); margin: 0.125rem 0 0;">{site.salud.alzheimer.doctor}</dd>
            </div>
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Horario</dt>
              <dd style="color: var(--color-text); margin: 0.125rem 0 0;">{site.salud.alzheimer.horario}</dd>
            </div>
            <div>
              <dt style="color: var(--color-text-muted); font-weight: 500;">Citas</dt>
              <dd style="margin: 0.125rem 0 0;">
                <a
                  href={`tel:${site.salud.alzheimer.telefono}`}
                  style="color: var(--color-primary); font-weight: 500; text-decoration: none;"
                  aria-label={`Llamar para cita de Alzheimer: ${site.salud.alzheimer.telefono}`}
                >
                  {site.salud.alzheimer.telefono}
                </a>
              </dd>
            </div>
          </dl>
        </article>

      </div>

      <!-- Banda de gratuidad -->
      <div
        style="
          background-color: var(--color-primary-soft);
          border-radius: 0.5rem;
          padding: 1.25rem 1.75rem;
          text-align: center;
        "
        role="note"
        aria-label="Nota sobre gratuidad del servicio"
      >
        <p
          style="
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--fs-h3);
            font-weight: 500;
            color: var(--color-primary);
            max-width: none;
          "
        >
          Todos los servicios de salud son completamente gratuitos.
        </p>
      </div>

    </div>
  </div>
</section>
